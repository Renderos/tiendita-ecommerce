# =====================================================================
#  Variables para docker compose
#  Copia este archivo a ".env" (en la raiz del repo) y completa los valores.
#  El archivo .env esta en .gitignore: NUNCA subas credenciales reales.
# =====================================================================

# ============ Base de datos (PostgreSQL en Neon) ============
# Host DIRECTO de Neon (el que NO lleva "-pooler" en el nombre).
# El pooler (PgBouncer) aborta las transacciones que abre Laravel al crear pedidos.
DB_HOST=ep-xxxxxxxx.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=tiendita_supermercado
DB_USERNAME=neondb_owner
DB_PASSWORD=
# Obligatorio: Neon rechaza conexiones sin SSL
DB_SSLMODE=require

# ============ Laravel ============
# Clave de cifrado de la app (obligatoria; el contenedor no arranca sin ella).
# Generala con:  docker compose run --rm api php artisan key:generate --show
# o, si tienes PHP local:  cd backend && php artisan key:generate --show
APP_KEY=
# URL publica de la API (se usa para generar enlaces absolutos)
APP_URL=http://localhost:8000

# ============ Stripe (modo test) ============
# Llaves del dashboard de Stripe -> Developers -> API keys (modo Test).
# STRIPE_KEY (pk_test_...) tambien se pasa al frontend como NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# en tiempo de build. Si la cambias, reconstruye el frontend: docker compose build frontend
STRIPE_KEY=pk_test_xxxxxxxx
# Llave secreta (sk_test_...): solo la usa la API para cobrar
STRIPE_SECRET=sk_test_xxxxxxxx

# ============ Comportamiento del contenedor api ============
# Ejecuta "php artisan migrate" al arrancar. Dejalo en false con Neon:
# el esquema ya existe y las migraciones fallarian con "relation already exists".
# Ponlo en true solo si apuntas a una base de PostgreSQL vacia.
RUN_MIGRATIONS=false
# Ejecuta los seeders al arrancar. false con Neon: ya trae categorias, marcas,
# productos y cupones de prueba.
RUN_SEED=false
# Genera documentacion Swagger al arrancar (requiere el paquete l5-swagger, no instalado)
GENERATE_SWAGGER=false
